# Copy this file to ".env" and fill in your real key. NEVER commit .env.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the local Express server listens on (optional, defaults to 8787)
PORT=8787

# Comma-separated list of origins allowed to call this API.
# For local testing the http.server on 8090 plus file:// is covered by default.
# In production set this to your live site, e.g. https://rooftoprobroofing.com
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
